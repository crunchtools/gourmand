@@ -86,6 +86,23 @@ impl Violation {
         self.item = Some(name.into());
         self
     }
+
+    /// Whether `needle` names this violation, for `pattern`-scoped exceptions.
+    ///
+    /// A violation with an `item` is matched on the item alone: messages
+    /// often name other code (copy-paste findings name the partner function
+    /// and file), so matching them would let a pattern cover findings it was
+    /// never written for. Only a violation without an item falls back to its
+    /// message. An empty needle mentions nothing: `pattern = ""` would
+    /// otherwise suppress the whole file while looking narrow.
+    #[must_use]
+    pub fn mentions(&self, needle: &str) -> bool {
+        !needle.is_empty()
+            && self
+                .item
+                .as_deref()
+                .map_or_else(|| self.message.contains(needle), |i| i.contains(needle))
+    }
 }
 
