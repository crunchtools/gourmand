+
+    fn pattern_exception(pattern: &str) -> CheckException {
+        CheckException {
+            check: "lint_suppression".to_string(),
+            path: "src/app.py".to_string(),
+            justification: "pattern-scoped".to_string(),
+            classification: Some(ExceptionClassification::ByDesign),
+            last_reviewed: None,
+            item: None,
+            line: None,
+            pattern: Some(pattern.to_string()),
+            source_file: None,
+        }
+    }
+
+    #[test]
+    fn pattern_scoped_exception_suppresses_only_matching_message() {
+        let crate_dir = make_test_root();
+        let crate_root = crate_dir.path().to_path_buf();
+        let file_path = crate_root.join("src").join("app.py");
+
+        let ctx = make_per_crate_ctx(crate_root, vec![pattern_exception("noqa: F401")]);
+
+        let excepted = Violation::new(&file_path, 3, "suppression comment: # noqa: F401");
+        let other = Violation::new(&file_path, 9, "suppression comment: # noqa: E501");
+
+        assert!(
+            ctx.match_violation_exception(&excepted, "lint_suppression")
+                .is_some(),
+            "finding whose message contains the pattern must be suppressed"
+        );
+        assert!(
+            ctx.match_violation_exception(&other, "lint_suppression")
+                .is_none(),
+            "finding in the same file without the pattern must still fire"
+        );
+    }
+
+    #[test]
+    fn pattern_scoped_exception_matches_item() {
+        let crate_dir = make_test_root();
+        let crate_root = crate_dir.path().to_path_buf();
+        let file_path = crate_root.join("src").join("app.py");
+
+        let ctx = make_per_crate_ctx(crate_root, vec![pattern_exception("_poll")]);
+
+        let excepted = Violation::new(&file_path, 3, "helper used once").with_item("_poll");
+        let other = Violation::new(&file_path, 9, "helper used once").with_item("_units");
+
+        assert!(
+            ctx.match_violation_exception(&excepted, "lint_suppression")
+                .is_some(),
+            "finding whose item contains the pattern must be suppressed"
+        );
+        assert!(
+            ctx.match_violation_exception(&other, "lint_suppression")
+                .is_none(),
+            "finding for another item must still fire"
+        );
+    }
+
+    #[test]
+    fn pattern_scoped_exception_does_not_skip_whole_file() {
+        let crate_dir = make_test_root();
+        let crate_root = crate_dir.path().to_path_buf();
+        let file_path = crate_root.join("src").join("app.py");
+
+        let ctx = make_per_crate_ctx(crate_root, vec![pattern_exception("noqa: F401")]);
+
+        assert!(
+            ctx.is_check_exception(&file_path, "lint_suppression")
+                .is_none(),
+            "a pattern-scoped exception is granular and must not skip the file"
+        );
+        assert!(
+            ctx.shared()
+                .exception_classification(&file_path, "lint_suppression")
+                .is_none(),
+            "shared file-level lookup must also ignore pattern-scoped exceptions"
+        );
+    }
 }
