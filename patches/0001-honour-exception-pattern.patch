+/// Whether a granular exception targets this violation: every one of its
+/// `item`, `line` (within `fuzziness`) and `pattern` that is set must match.
+fn exception_targets(exception: &config::CheckException, v: &Violation, fuzziness: usize) -> bool {
+    if let Some(exc_item) = &exception.item
+        && v.item.as_deref() != Some(exc_item.as_str())
+    {
+        return false;
+    }
+    if let Some(exc_line) = exception.line
+        && v.line.is_none_or(|vl| vl.abs_diff(exc_line) > fuzziness)
+    {
+        return false;
+    }
+    if let Some(needle) = &exception.pattern
+        && !v.mentions(needle)
+    {
+        return false;
+    }
+    true
