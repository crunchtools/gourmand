+fn pattern_scoped_migrate_format_preserves_pattern() {
+    let tmp = common::var_tmp_dir();
+    let dir = tmp.path();
+    let d_dir = setup_repo_with_d_dir(dir);
+
+    write_flat_exception(
+        &d_dir,
+        "check_a--src-foo-rs.toml",
+        "check = \"check_a\"\npath = \"src/foo.rs\"\npattern = \"noqa: F401\"\njustification = \"reason a1\"\nclassification = \"by_design\"\n",
+    );
+    commit_all(dir);
+
+    let output = run_migrate_format(dir, &["--apply"]);
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert!(
+        output.status.success(),
+        "--apply must exit 0; stderr: {stderr}"
+    );
+
+    let written =
+        fs::read_to_string(d_dir.join("check_a.toml")).expect("BUG: check_a.toml must be created");
+    assert!(
+        written.contains("pattern = \"noqa: F401\""),
+        "check-first output must keep the pattern; got: {written}"
